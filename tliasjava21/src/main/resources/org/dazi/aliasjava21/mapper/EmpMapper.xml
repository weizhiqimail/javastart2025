<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.dazi.tliasjava21.mapper.EmpMapper">
    <select id="getEmpList" resultMap="empWithDeptAndExprMap">
        SELECT
            e.id AS id,
            e.username AS username,
            e.name AS name,
            e.job AS job,
            e.salary AS salary,
            e.entry_date AS entry_date,
            dept.name AS deptName,
            expr.id AS expr_id,
            expr.company_name AS companyName,
            expr.job AS expr_job,
            expr.start_date AS startDate,
            expr.end_date AS endDate
        FROM emp e
        LEFT JOIN dept ON e.dept_id = dept.id
        LEFT JOIN expr ON e.id = expr.emp_id
        <where>
            <if test="username != null and username != ''">
                e.username LIKE CONCAT('%', #{username}, '%')
            </if>
            <if test="name != null and name != ''">
                e.name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="gender != null">
                AND e.gender = #{gender}
            </if>
            <if test="startDate != null and endDate != null">
                AND e.entry_date BETWEEN #{startDate} AND #{endDate}
            </if>
        </where>
        ORDER BY e.entry_date DESC, expr.start_date ASC
    </select>

    <resultMap id="empWithDeptAndExprMap" type="org.dazi.tliasjava21.dao.EmpWithDeptAndExpr">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="name" column="name"/>
        <result property="job" column="job"/>
        <result property="salary" column="salary"/>
        <result property="entryDate" column="entry_date"/>
        <result property="deptName" column="deptName"/>

        <collection property="exprList" ofType="org.dazi.tliasjava21.pojo.Expr">
            <id property="id" column="expr_id"/>
            <result property="empId" column="id"/>
            <result property="companyName" column="companyName"/>
            <result property="job" column="job"/>
            <result property="startDate" column="startDate"/>
            <result property="endDate" column="endDate"/>
        </collection>

    </resultMap>

</mapper>