<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.dazi.tliasjava21.mapper.EmpMapper">
    <select id="getEmpList" resultType="org.dazi.tliasjava21.pojo.Emp">
        SELECT e.*, d.name AS deptName FROM emp e LEFT JOIN dept d ON e.dept_id = d.id ORDER BY e.entry_date DESC
    </select>
</mapper>